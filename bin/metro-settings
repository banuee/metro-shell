#!/bin/bash
# metro-settings — запуск/перезапуск приложения настроек (отдельный инстанс quickshell)
pkill -f "quickshell -p $HOME/.config/quickshell/metro-settings" 2>/dev/null
sleep 0.2
QT_QPA_PLATFORMTHEME=gtk3 setsid quickshell -p "$HOME/.config/quickshell/metro-settings" >/tmp/qs-metro-settings.log 2>&1 </dev/null &
echo "metro-settings запущен, лог: /tmp/qs-metro-settings.log"
