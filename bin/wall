#!/usr/bin/env bash
# wall — change wallpaper via awww with animation + auto theme recolor
#
#   wall <image>          set wallpaper (with transition animation)
#   wall random | rand    random from ~/Wallpapers (up to 2 levels deep)
#   wall -t <type> [img]  choose transition type: fade grow any outer wave wipe
#                         left right top bottom random
#   wall --no-theme       skip metro-colors recoloring
#
# Recoloring affects: Theme.qml across all instances via matugen (Material You).
#
# Environment variables: WALL_FPS (default 120), WALL_TRANSITION (default type).
set -u

WALLDIR="$HOME/Wallpapers"
STATEDIR="${XDG_STATE_HOME:-$HOME/.local/state}/metro"
mkdir -p "$STATEDIR"
FPS="${WALL_FPS:-120}"
THEME=1
TYPE="${WALL_TRANSITION:-}"
IMG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t) TYPE="$2"; shift 2 ;;
        --no-theme) THEME=0; shift ;;
        -h|--help) grep '^#' "$0" | cut -c3-; exit 0 ;;
        *) IMG="$1"; shift ;;
    esac
done

cur="$(cat "$STATEDIR/wall" 2>/dev/null || true)"

if [[ -z "$IMG" || "$IMG" == "random" || "$IMG" == "rand" ]]; then
    all_imgs="$(find "$WALLDIR" -maxdepth 2 -type f 2>/dev/null | grep -Ei '\.(jpe?g|png|webp|gif|bmp)$')"
    pick="$(echo "$all_imgs" | grep -Fvx "$cur" | shuf -n1)"
    [[ -n "$pick" && -f "$pick" ]] || pick="$(echo "$all_imgs" | shuf -n1)"
    if [[ -f "$pick" ]]; then IMG="$pick"; fi
fi

if [[ ! -f "$IMG" ]]; then
    echo "[wall] wallpaper file not found: '$IMG'" >&2
    exit 1
fi
IMG="$(readlink -f "$IMG")"
TARGET_IMG="$IMG"
case "${IMG,,}" in
    *.mp4|*.webm|*.mkv|*.mov)
        CACHEDIR="${XDG_CACHE_HOME:-$HOME/.cache}/metro/live_walls"
        mkdir -p "$CACHEDIR"
        HASH="$(sha256sum "$IMG" | cut -d' ' -f1)"
        WEBP_OUT="$CACHEDIR/${HASH}.webp"
        if [[ ! -f "$WEBP_OUT" ]]; then
            echo "[wall] generating live loop preview: $IMG..." >&2
            ffmpeg -y -t 12 -i "$IMG" -vf "scale=1920:-1:flags=lanczos,fps=30" -loop 0 -q:v 75 "$WEBP_OUT" >/dev/null 2>&1 || true
        fi
        if [[ -f "$WEBP_OUT" ]]; then
            TARGET_IMG="$WEBP_OUT"
        fi
        ;;
esac

T="${TYPE:-$(echo fade grow any outer wave left right wipe | tr ' ' '\n' | shuf -n1)}"
case "$T" in
    fade)   FLAGS=(--transition-duration 2.8 --transition-bezier .65,0,.35,1) ;;
    grow)   FLAGS=(--transition-duration 2.2 --transition-pos 0.5,0.42) ;;
    any)    FLAGS=(--transition-duration 2.2) ;;
    outer)  FLAGS=(--transition-duration 2.4) ;;
    wave)   FLAGS=(--transition-duration 3.0 --transition-angle 315 --transition-wave 90,150) ;;
    left|right|top|bottom) FLAGS=(--transition-duration 2.2) ;;
    wipe)   FLAGS=(--transition-duration 2.4 --transition-angle $((RANDOM % 12 * 30))) ;;
    *)      FLAGS=(--transition-duration 2.5) ;;
esac

if ! out="$(awww img --resize crop -f Lanczos3 --transition-type "$T" \
        --transition-fps "$FPS" ${FLAGS[@]+"${FLAGS[@]}"} "$TARGET_IMG" 2>&1)"; then
    echo "[wall] error: $out" >&2
    echo "[wall] if daemon is not running — run: wall-start" >&2
    exit 1
fi

printf '%s\n' "$IMG" > "$STATEDIR/wall"
printf '%s\n' "wallpaper: $IMG  [$T, ${FPS}fps]"
printf '%s\n' "$T" > "$STATEDIR/last-transition"

if (( THEME )); then
    metro-colors >/dev/null 2>&1 && printf '%s\n' "theme: $(metro-colors status)" \
        || echo "[wall] metro-colors failed (non-critical)" >&2
fi
