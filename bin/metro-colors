[urgency=low]
border-color=#ffffff30
default-timeout=4000

[urgency=critical]
border-color=#e5484dff
default-timeout=0
text-color=#ffffffff
"""


def apply_mako_config(tokens, theme_name, vivid_accent):
    """Перегенерировать ~/.config/mako/config под тему. Возвращает True если записали."""
    try:
        content = build_mako_config(tokens, theme_name, vivid_accent)
        os.makedirs(os.path.dirname(MAKO_CONF), exist_ok=True)
        old = ""
        if os.path.isfile(MAKO_CONF):
            with open(MAKO_CONF, encoding="utf-8") as f:
                old = f.read()
        if content != old:
            with open(MAKO_CONF, "w", encoding="utf-8") as f:
                f.write(content)
            try:
                subprocess.run(["makoctl", "reload"], capture_output=True, timeout=3)
            except Exception:
                pass
            return True
        return False
    except OSError as e:
        print(f"[metro-colors] mako write failed: {e}", file=sys.stderr)
        return False


def apply_theme_colors(tokens, image=None, theme_name=None, custom_accent=None):
    cfg = conf()
    if not theme_name:
        theme_name = get_active_theme_id()

    # Акцент: явный custom > зафиксированный в конфиге hex (только metro/wp;
    # у material свои динамические M3-токены — пин metro туда не протекает,
    # иначе слайдеры CC темнеют; явный `set` в material работает как раньше).
    pinned = cfg.get("accent", "auto").strip()
    use_pin = pinned.startswith("#") and theme_name in ("wp", "metro")
    if custom_accent and custom_accent != "auto":
        vivid_acc = custom_accent
        conf_write("accent", custom_accent)
    elif custom_accent == "auto" or pinned == "auto":
        vivid_acc = None
        if theme_name in ("wp", "metro") and image:
            vivid_acc = extract_vivid_accent(image)
        if custom_accent == "auto":
            conf_write("accent", "auto")
    elif use_pin:
        vivid_acc = pinned
    else:
        vivid_acc = None
        if theme_name in ("wp", "metro") and image:
            vivid_acc = extract_vivid_accent(image)

    primary = vivid_acc or tokens.get("primary", DEFAULT_TOKENS["primary"])
    container = tokens.get("primary_container", DEFAULT_TOKENS["primary_container"])
    surface = tokens.get("surface", DEFAULT_TOKENS["surface"])

    print(f"theme: {theme_name}")
    print(f"wallpaper: {image}" if image else "wallpaper: not specified")
    preview("primary/accent", primary)
    if theme_name == "material":
        preview("primary_container", container)
        preview("surface", surface)
    backup()

    theme_content = build_theme_qml(tokens, theme_name, vivid_acc)

    # Палитра логотипа (4 цвета) — без лишних вызовов matugen:
    # metro/wp = vivid-акцент + реальные цвета PIL; material = токены M3.
    if theme_name == "material":
        logo_palette = [
            tokens.get("primary", DEFAULT_TOKENS["primary"]),
            tokens.get("secondary", DEFAULT_TOKENS["secondary"]),
            tokens.get("tertiary", DEFAULT_TOKENS["tertiary"]),
            tokens.get("primary_container", DEFAULT_TOKENS["primary_container"]),
        ]
    else:
        logo_palette = []
        if vivid_acc:
            logo_palette.append(vivid_acc)
        if image:
            try:
                for cand in palette_from_pil(image, limit=5):
                    if cand not in logo_palette:
                        logo_palette.append(cand)
                    if len(logo_palette) >= 4:
                        break
            except Exception:
                pass
        while len(logo_palette) < 4:
            logo_palette += ["#00aba9", "#0050ef", "#a200ff", "#10893e"]
        logo_palette = logo_palette[:4]
    try:
        pal_path = os.path.expanduser("~/.local/state/metro/palette.json")
        os.makedirs(os.path.dirname(pal_path), exist_ok=True)
        with open(pal_path, "w", encoding="utf-8") as f:
            json.dump(logo_palette, f)
    except Exception as e:
        print(f"[metro-colors] palette write failed: {e}", file=sys.stderr)

    changed_count = 0
    for tag, path, kind in MANAGED_TARGETS:
        if kind == "theme":
            content = theme_content
            # Тёмный glassDeep настроек — только для metro + settings.glass=dark;
            # иначе тема/фон не переключаются (баг 09.09: оверрайд душил material).
            dark_settings = theme_name == "metro" and cfg.get("settings.glass", "dark") == "dark"
            override = GLASS_DEEP_OVERRIDE.get(tag) if dark_settings else None
            if override:
                content = GLASS_DEEP_RE.sub(r"\1" + override, content)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(content)
            changed_count += 1

    # metro-shot: только teal-патч акцента (поверхности/прозрачность — свои).
    # Отключается через shot.accent_follow = false в metro-shell.conf.
    if cfg.get("shot.accent_follow", "true").lower() == "true" and os.path.isfile(SHOT_THEME):
        try:
            with open(SHOT_THEME, encoding="utf-8") as f:
                shot = f.read()
            shot2 = TEAL_RE.sub(r'\1"%s"' % primary, shot)
            if shot2 != shot:
                with open(SHOT_THEME, "w", encoding="utf-8") as f:
                    f.write(shot2)
                changed_count += 1
        except OSError as e:
            print(f"[metro-colors] shot teal patch failed: {e}", file=sys.stderr)

    # mako: полный реген под тему (фон/рамка/прогресс/радиусы/шрифт).
    # Юзерские timeout/anchor/max-visible подхватываются из текущего конфига.
    if apply_mako_config(tokens, theme_name, vivid_acc):
        changed_count += 1
        preview("mako border/progress", primary)

    # Композитор: дефолты темы, поверх — metro-shell.conf (compositor.*).
    hypr_lua = Path.home() / ".config/hypr/hyprland.lua"
    if hypr_lua.exists():
        rounding_map = {"material": 24, "metro": 12, "wp": 0}
        blur_map = {"material": "true", "metro": "true", "wp": "false"}
        try:
            rounding = int(float(cfg.get("compositor.rounding", rounding_map.get(theme_name, 12))))
        except (ValueError, TypeError):
            rounding = rounding_map.get(theme_name, 12)
        blur_val = "true" if str(cfg.get("compositor.blur", blur_map.get(theme_name, "true"))).lower() == "true" else "false"
        try:
            hcontent = hypr_lua.read_text()
            hcontent = re.sub(r'(blur\s*=\s*\{\s*enabled\s*=\s*)(true|false)', rf'\g<1>{blur_val}', hcontent)
            hcontent = re.sub(r'(rounding\s*=\s*)\d+', rf'\g<1>{rounding}', hcontent)
            hypr_lua.write_text(hcontent)
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=3)
        except Exception:
            pass

    print(f"done ({changed_count} files updated, quickshell will reload configs)")


def palette(image):
    theme_name = get_active_theme_id()
    if theme_name == "material":
        tokens = extract_tokens_matugen(image_path=image)
        return [
            tokens.get("primary", "#8cd5b3"),
            tokens.get("secondary", "#b3ccbe"),
            tokens.get("tertiary", "#a5ccdf"),
            tokens.get("primary_container", "#005139"),
            tokens.get("surface_container_high", "#252b28"),
        ]
    else:
        cands = []
        try:
            acc = extract_vivid_accent(image)
            if acc:
                cands.append(acc)
        except Exception:
            pass
        for cand in palette_from_pil(image):
            if cand not in cands:
                cands.append(cand)
            if len(cands) >= 5:
                break
        return cands or ["#00aba9", "#0050ef", "#a200ff", "#10893e", "#e51400"]


def main():
    ap = argparse.ArgumentParser(prog="metro-colors", add_help=False)
    ap.add_argument("image", nargs="?")
    ap.add_argument("arg2", nargs="?")
    ap.add_argument("--theme", type=str, default=None)
    ap.add_argument("--vivid", action="store_true")
    ap.add_argument("--reset", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--status-hex", action="store_true")
    ap.add_argument("--from-conf", action="store_true")
    a = ap.parse_args()

    if a.from_conf or a.image == "from-conf":
        # Полная регенерация из metro-shell.conf (зовёт metro-conf apply).
        # Пин акцента действует только на metro/wp; material всегда строится
        # от обоев (иначе metro-пин темнит M3-слайдеры и поверхности).
        cfg = conf()
        theme_name = cfg.get("theme", "metro").strip() or "metro"
        acc = cfg.get("accent", "auto").strip()
        image = current_wallpaper()
        if theme_name == "material":
            tokens = extract_tokens_matugen(image_path=image) if image else dict(DEFAULT_TOKENS)
            apply_theme_colors(tokens, image, theme_name, None)
        elif acc == "auto" or not acc.startswith("#"):
            tokens = extract_tokens_matugen(image_path=image) if image else dict(DEFAULT_TOKENS)
            apply_theme_colors(tokens, image, theme_name, None)
        else:
            tokens = extract_tokens_matugen(hex_color=acc)
            apply_theme_colors(tokens, image, theme_name, acc)
        return

    if a.status_hex or a.image == "status-hex":
        if os.path.isfile(THEME):
            with open(THEME, encoding="utf-8") as f:
                m = TEAL_RE.search(f.read())
            print(m.group(0).split('"')[1] if m else DEFAULT_TOKENS["primary"])
        else:
            print(DEFAULT_TOKENS["primary"])
        return

    if a.reset or a.image == "reset":
        restore_defaults()
        print("done (all quickshell instances reloaded saved defaults)")
        return

    if a.image == "save-defaults":
        save_defaults()
        return

    if a.status or a.image == "status":
        if os.path.isfile(THEME):
            with open(THEME, encoding="utf-8") as f:
                m = TEAL_RE.search(f.read())
            preview("current", m.group(0).split('"')[1] if m else "?")
        return

    if a.image in ("help", "--help"):
        raise SystemExit(__doc__)

    theme_name = a.theme or get_active_theme_id()

    if a.image == "set":
        if not a.arg2:
            raise SystemExit("[metro-colors] specify color: metro-colors set #rrggbb|auto")
        if a.arg2 == "auto":
            image = current_wallpaper()
            tokens = extract_tokens_matugen(image_path=image) if image else dict(DEFAULT_TOKENS)
            apply_theme_colors(tokens, image, theme_name, "auto")
            return
        hexcol = a.arg2 if a.arg2.startswith("#") else "#" + a.arg2
        tokens = extract_tokens_matugen(hex_color=hexcol)
        image = current_wallpaper()
        apply_theme_colors(tokens, image, theme_name, hexcol)
        return

    if a.image == "palette":
        image = a.arg2 or current_wallpaper()
        if not image or not os.path.isfile(os.path.expanduser(image)):
            raise SystemExit("[metro-colors] no wallpaper for palette")
        cands = palette(os.path.expanduser(image))
        for i, c in enumerate(cands):
            preview(f"#{i + 1}", c)
            print(c)
        return

    image = a.image or current_wallpaper()
    if not image or not os.path.isfile(os.path.expanduser(image)):
        raise SystemExit("[metro-colors] current wallpaper not found — specify path: metro-colors <image>")

    tokens = extract_tokens_matugen(image_path=os.path.expanduser(image))
    apply_theme_colors(tokens, os.path.expanduser(image), theme_name)


if __name__ == "__main__":
    main()
