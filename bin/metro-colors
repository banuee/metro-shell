sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import metro_conf
    from metro_conf import conf_float, conf_int
except ImportError:
    metro_conf = None

    def conf_float(cfg, key, lo=0.0, hi=1.0):
        try:
            return max(lo, min(hi, float(cfg.get(key, 0.3))))
        except (ValueError, TypeError):
            return 0.3

    def conf_int(cfg, key, lo=0, hi=64):
        try:
            return max(lo, min(hi, int(float(cfg.get(key, 16)))))
        except (ValueError, TypeError):
            return 16


def conf():
    if metro_conf is not None:
        return metro_conf.load()
    return {}

DIR = os.path.expanduser("~/.config/quickshell/metro")
