def hex_to_hls(hx):
    hx = hx.lstrip("#")
    r, g, b = (int(hx[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    return colorsys.rgb_to_hls(r, g, b)


def hls_to_hex(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (r, g, b))


def normalize(hx, lo, hi, smin):
    h, l, s = hex_to_hls(hx)
    return hls_to_hex(h, max(lo, min(hi, l)), max(smin, min(1.0, s)))


def hue_dist(a, b):
    d = abs(a - b) % 1.0
    return min(d, 1.0 - d)


def extract_vivid_accent(image_path=None, hex_color=None):
    if hex_color:
        return hex_color
    if not image_path or not os.path.isfile(image_path):
        return "#00aba9"

    # 1. Try matugen saturation prefer
    try:
        r = subprocess.run(
            ["matugen", "image", image_path, "--mode", "dark", "--dry-run", "-j", "hex", "--prefer", "saturation"],
            capture_output=True, text=True, timeout=4
        )
        if r.returncode == 0:
            data = json.loads(r.stdout)
            src = data.get("colors", {}).get("source_color", {}).get("dark", {}).get("color", "")
            if src:
                return normalize(src, 0.38, 0.56, 0.50)
    except Exception:
        pass

    # 2. Try PIL mediancut fallback
    try:
        from PIL import Image
        im = Image.open(image_path).convert("RGB").resize((96, 96))
        q = im.quantize(colors=48, method=Image.Quantize.MEDIANCUT).convert("RGB")
        raw = q.tobytes()
        counts = {}
        for i in range(0, len(raw), 3):
            px = (raw[i], raw[i + 1], raw[i + 2])
            counts[px] = counts.get(px, 0) + 1

        def score(px):
            h, l, s = colorsys.rgb_to_hls(*[c / 255.0 for c in px])
            w = (0.05 + s ** 2) * (1.5 if 0.20 < l < 0.80 else 0.3)
            return counts[px] * w

        best = max(counts, key=score)
        hx = "#%02x%02x%02x" % best
        return normalize(hx, 0.38, 0.56, 0.50)
    except Exception:
        return "#00aba9"


def palette_from_pil(image, limit=5):
    try:
        from PIL import Image
        im = Image.open(image).convert("RGB").resize((128, 128))
        q = im.quantize(colors=64, method=Image.Quantize.MEDIANCUT).convert("RGB")
        raw = q.tobytes()
        counts = {}
        for i in range(0, len(raw), 3):
            px = (raw[i], raw[i + 1], raw[i + 2])
            counts[px] = counts.get(px, 0) + 1
        scored = sorted(counts.items(), key=lambda kv: -kv[1])
        out = []
        for px, _cnt in scored:
            hx = "#%02x%02x%02x" % px
            h, l, s = hex_to_hls(hx)
            if s < 0.14:
                continue
            cand = normalize(hx, 0.36, 0.54, 0.45)
            ch, cl, _ = hex_to_hls(cand)
            if any(hue_dist(ch, eh) < 0.06 and abs(cl - el) < 0.15 for ex, el, eh in out):
                continue
            out.append((cand, cl, ch))
            if len(out) >= limit:
                break
        return [c for c, _l, _h in out]
    except Exception:
        return ["#00aba9", "#0050ef", "#a200ff", "#10893e", "#e51400"]


def get_active_theme_id():
    # Источник правды — metro-shell.conf; state-файл — для совместимости.
    try:
        t = conf().get("theme", "").strip()
        if t in ("material", "metro", "wp"):
            return t
    except Exception:
        pass
    st = os.path.expanduser("~/.local/state/metro/theme")
    if os.path.isfile(st):
        try:
            t = open(st).read().strip()
            if t in ("material", "metro", "wp"):
                return t
        except Exception:
            pass
    return "metro"


def conf_write(key, value):
    """Записать ключ в metro-shell.conf (структура/комменты сохраняются).
    Пустая запись пропускается — иначе вотчер конфига зациклится."""
    try:
        if metro_conf is not None and metro_conf.load().get(key) == value:
            return
    except Exception:
        pass
    r = subprocess.run(["metro-conf", "set", "--no-apply", key, value],
                       capture_output=True, text=True)
    if r.returncode != 0:
        print(f"[metro-colors] conf write failed: {r.stderr.strip()}", file=sys.stderr)


def backup():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    ts = int(time.time())
    for tag, path, _ in MANAGED_TARGETS:
        if os.path.isfile(path):
            ext = os.path.splitext(path)[1] or ".qml"
            shutil.copy2(path, os.path.join(BACKUP_DIR, f"{tag}-{ts}{ext}"))
    for tag, _, _ in MANAGED_TARGETS:
        files = sorted(glob.glob(os.path.join(BACKUP_DIR, f"{tag}-*")))
        for f in files[:-5]:
            try:
                os.remove(f)
            except OSError:
                pass


def save_defaults():
    os.makedirs(BACKUP_DIR, exist_ok=True)
    saved = 0
    for tag, path, _ in MANAGED_TARGETS:
        if os.path.isfile(path):
            ext = os.path.splitext(path)[1] or ".qml"
            dst = os.path.join(BACKUP_DIR, f"{tag}.default{ext}")
            shutil.copy2(path, dst)
            saved += 1
    print(f"saved benchmark defaults ({saved} files)")


def restore_defaults():
    restored = 0
    for tag, path, _ in MANAGED_TARGETS:
        ext = os.path.splitext(path)[1] or ".qml"
        src = os.path.join(BACKUP_DIR, f"{tag}.default{ext}")
        if os.path.isfile(src):
            shutil.copy2(src, path)
            restored += 1
    if restored > 0:
        print(f"restored {restored} files from benchmark")
    else:
        print("[metro-colors] no benchmark saved — run save-defaults first", file=sys.stderr)


def current_wallpaper():
    st = os.path.expanduser("~/.local/state/metro/wall")
    if os.path.isfile(st):
        try:
            path = open(st).read().strip()
            if os.path.isfile(path):
                return path
        except Exception:
            pass
    return None


def extract_tokens_matugen(image_path=None, hex_color=None):
    if hex_color:
        cmd = ["matugen", "color", "hex", hex_color, "--json", "hex", "--mode", "dark"]
    elif image_path:
        cmd = ["matugen", "image", image_path, "--source-color-index", "0", "--json", "hex", "--mode", "dark"]
    else:
        return dict(DEFAULT_TOKENS)

    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            print(f"[metro-colors] matugen error: {r.stderr.strip()}", file=sys.stderr)
            return dict(DEFAULT_TOKENS)
        data = json.loads(r.stdout)
        colors = data.get("colors", {})
        tokens = dict(DEFAULT_TOKENS)
        for k in tokens.keys():
            if k in colors:
                val = colors[k].get("dark", colors[k].get("default", {})).get("color", "")
                if val:
                    tokens[k] = val
        return tokens
    except Exception as e:
        print(f"[metro-colors] matugen exception: {e}", file=sys.stderr)
        return dict(DEFAULT_TOKENS)


def build_theme_qml(tokens, theme_name="material", vivid_accent=None, cfg=None):
    cfg = cfg or conf()
    is_wp = theme_name == "wp"
    is_metro = theme_name == "metro"
    is_mat = not is_wp and not is_metro

    p = vivid_accent or tokens.get("primary", DEFAULT_TOKENS["primary"])

    # Per-panel поверхности из metro-shell.conf (только metro; у wp/material
    # своя айдентика — им подставляем общие bg/radius ниже).
    panel_top_bg = panel_left_bg = panel_right_bg = None
    panel_top_radius = panel_left_radius = panel_right_radius = None

    if is_wp:
        font_family = "Segoe UI Variable Static Text"
        headline_font = "Segoe UI Variable Static Display Light"
        icon_font = "NotoSans Nerd Font"
        radius = 0
        radius_small = 0
        radius_large = 0
        radius_pill = 0
        panel_radius = 0
        bg_str = "Qt.rgba(0.04, 0.04, 0.04, 0.85)"
        bg_card_str = "Qt.rgba(1, 1, 1, 0.08)"
        bg_card_hover_str = "Qt.rgba(1, 1, 1, 0.15)"
        glass_str = "Qt.rgba(1, 1, 1, 0.08)"
        glass_hover_str = "Qt.rgba(1, 1, 1, 0.15)"
        glass_deep_str = "Qt.rgba(0.06, 0.06, 0.06, 0.95)"
        stroke_str = "Qt.rgba(1, 1, 1, 0.10)"
        stroke_strong_str = "Qt.rgba(1, 1, 1, 0.25)"
        tile_alpha = 1.0
        text_str = '"#f7f7f7"'
        text_dim_str = "Qt.rgba(1, 1, 1, 0.60)"
        primary_token = p
        on_primary_token = "#ffffff"
    elif is_metro:
        font_family = cfg.get("fonts.family", "Segoe UI Variable Static Text")
        headline_font = cfg.get("fonts.headline", "Segoe UI Variable Static Display Light")
        icon_font = cfg.get("fonts.icon", "NotoSans Nerd Font")
        radius = 10
        radius_small = 8
        radius_large = 14
        radius_pill = 999
        panel_radius = 16
        bg_str = "Qt.rgba(0.10, 0.10, 0.10, 0.30)"
        bg_card_str = "Qt.rgba(1, 1, 1, 0.07)"
        bg_card_hover_str = "Qt.rgba(1, 1, 1, 0.12)"
        glass_str = "Qt.rgba(1, 1, 1, 0.07)"
        glass_hover_str = "Qt.rgba(1, 1, 1, 0.12)"
        glass_deep_str = "Qt.rgba(255, 255, 255, 0.06)"
        stroke_str = "Qt.rgba(1, 1, 1, 0.08)"
        stroke_strong_str = "Qt.rgba(1, 1, 1, 0.15)"
        tile_alpha = 0.85
        text_str = '"#f7f7f7"'
        text_dim_str = "Qt.rgba(1, 1, 1, 0.60)"
        primary_token = p
        on_primary_token = "#ffffff"
        panel_top_bg = "Qt.rgba(0.10, 0.10, 0.10, %.2f)" % conf_float(cfg, "panel.toppanel_bg")
        panel_left_bg = "Qt.rgba(0.10, 0.10, 0.10, %.2f)" % conf_float(cfg, "panel.launcher_bg")
        panel_right_bg = "Qt.rgba(0.10, 0.10, 0.10, %.2f)" % conf_float(cfg, "panel.control_bg")
        panel_top_radius = conf_int(cfg, "panel.toppanel_radius")
        panel_left_radius = conf_int(cfg, "panel.launcher_radius")
        panel_right_radius = conf_int(cfg, "panel.control_radius")
    else:  # material
        font_family = "Google Sans"
        headline_font = "Google Sans"
        icon_font = "NotoSans Nerd Font"
        radius = 24
        radius_small = 14
        radius_large = 28
        radius_pill = 999
        panel_radius = 28
        bg_str = "Qt.rgba(surface.r, surface.g, surface.b, 0.90)"
        bg_card_str = "surface_container"
        bg_card_hover_str = "surface_container_high"
        glass_str = "surface_container"
        glass_hover_str = "surface_container_high"
        glass_deep_str = "Qt.rgba(surface_container_lowest.r, surface_container_lowest.g, surface_container_lowest.b, 0.96)"
        stroke_str = "Qt.rgba(outline_variant.r, outline_variant.g, outline_variant.b, 0.22)"
        stroke_strong_str = "Qt.rgba(outline.r, outline.g, outline.b, 0.38)"
        tile_alpha = 1.0
        text_str = "on_surface"
        text_dim_str = "on_surface_variant"
        primary_token = tokens.get('primary', DEFAULT_TOKENS['primary'])
        on_primary_token = tokens.get('on_primary', DEFAULT_TOKENS['on_primary'])

    if panel_top_bg is None:
        # wp/material: per-panel токенов нет — панели делят общий фон/радиус
        panel_top_bg = panel_left_bg = panel_right_bg = bg_str
        panel_top_radius = panel_left_radius = panel_right_radius = panel_radius

    return f"""pragma Singleton
import QtQuick

QtObject {{
    readonly property string themeName: "{theme_name}"
    readonly property bool isMaterial: themeName === "material"
    readonly property bool isWP: themeName === "wp"
    readonly property bool isMetro: themeName === "metro"
    readonly property bool isLiquidGlass: false

    readonly property string fontFamily: "{font_family}"
    readonly property string headlineFont: "{headline_font}"
    readonly property string iconFont: "{icon_font}"

    // Material 3 Dynamic Color Tokens (M3 / Material You)
    readonly property color primary: "{primary_token}"
    readonly property color on_primary: "{on_primary_token}"
    readonly property color primary_container: "{tokens.get('primary_container', DEFAULT_TOKENS['primary_container'])}"
    readonly property color on_primary_container: "{tokens.get('on_primary_container', DEFAULT_TOKENS['on_primary_container'])}"

    readonly property color secondary: "{tokens.get('secondary', DEFAULT_TOKENS['secondary'])}"
    readonly property color on_secondary: "{tokens.get('on_secondary', DEFAULT_TOKENS['on_secondary'])}"
    readonly property color secondary_container: "{tokens.get('secondary_container', DEFAULT_TOKENS['secondary_container'])}"
    readonly property color on_secondary_container: "{tokens.get('on_secondary_container', DEFAULT_TOKENS['on_secondary_container'])}"

    readonly property color tertiary: "{tokens.get('tertiary', DEFAULT_TOKENS['tertiary'])}"
    readonly property color on_tertiary: "{tokens.get('on_tertiary', DEFAULT_TOKENS['on_tertiary'])}"
    readonly property color tertiary_container: "{tokens.get('tertiary_container', DEFAULT_TOKENS['tertiary_container'])}"
    readonly property color on_tertiary_container: "{tokens.get('on_tertiary_container', DEFAULT_TOKENS['on_tertiary_container'])}"

    readonly property color surface: "{tokens.get('surface', DEFAULT_TOKENS['surface'])}"
    readonly property color on_surface: "{tokens.get('on_surface', DEFAULT_TOKENS['on_surface'])}"
    readonly property color surface_variant: "{tokens.get('surface_variant', DEFAULT_TOKENS['surface_variant'])}"
    readonly property color on_surface_variant: "{tokens.get('on_surface_variant', DEFAULT_TOKENS['on_surface_variant'])}"

    readonly property color surface_container_lowest: "{tokens.get('surface_container_lowest', DEFAULT_TOKENS['surface_container_lowest'])}"
    readonly property color surface_container_low: "{tokens.get('surface_container_low', DEFAULT_TOKENS['surface_container_low'])}"
    readonly property color surface_container: "{tokens.get('surface_container', DEFAULT_TOKENS['surface_container'])}"
    readonly property color surface_container_high: "{tokens.get('surface_container_high', DEFAULT_TOKENS['surface_container_high'])}"
    readonly property color surface_container_highest: "{tokens.get('surface_container_highest', DEFAULT_TOKENS['surface_container_highest'])}"

    readonly property color outline: "{tokens.get('outline', DEFAULT_TOKENS['outline'])}"
    readonly property color outline_variant: "{tokens.get('outline_variant', DEFAULT_TOKENS['outline_variant'])}"

    readonly property color error: "{tokens.get('error', DEFAULT_TOKENS['error'])}"
    readonly property color on_error: "{tokens.get('on_error', DEFAULT_TOKENS['on_error'])}"
    readonly property color error_container: "{tokens.get('error_container', DEFAULT_TOKENS['error_container'])}"
    readonly property color on_error_container: "{tokens.get('on_error_container', DEFAULT_TOKENS['on_error_container'])}"

    // Accent & Compatibility Bindings
    readonly property color teal: "{p}"
    readonly property color accent: teal

    // WP-палитра функциональных цветов (CPU/RAM/GPU/BAT, ошибки и т.п.)
    readonly property color purple: "#a200ff"
    readonly property color orange: "#f09609"
    readonly property color green: "#10893e"
    readonly property color lime: "#7e9600"
    readonly property color red: "#e51400"

    // Background & Card surfaces
    readonly property color bg: {bg_str}
    readonly property color bgCard: {bg_card_str}
    readonly property color bgCardHover: {bg_card_hover_str}
    readonly property color text: {text_str}
    readonly property color textDim: {text_dim_str}

    readonly property color glass: {glass_str}
    readonly property color glassHover: {glass_hover_str}
    readonly property color glassDeep: {glass_deep_str}
    readonly property color stroke: {stroke_str}
    readonly property color strokeStrong: {stroke_strong_str}

    // Radii & Dimensions
    readonly property int unit: 84
    readonly property int gap: 8
    readonly property int radius: {radius}
    readonly property int radiusSmall: {radius_small}
    readonly property int radiusLarge: {radius_large}
    readonly property int radiusPill: {radius_pill}
    readonly property int panelRadius: {panel_radius}
    readonly property int panelWidth: 400
    readonly property real tileAlpha: {tile_alpha}

    // Per-panel поверхности (metro-shell.conf → panel.*)
    readonly property color panelTopBg: {panel_top_bg}
    readonly property color panelLeftBg: {panel_left_bg}
    readonly property color panelRightBg: {panel_right_bg}
    readonly property int panelTopRadius: {panel_top_radius}
    readonly property int panelLeftRadius: {panel_left_radius}
    readonly property int panelRightRadius: {panel_right_radius}

    function tileW(cols) {{
        return cols * unit + (cols - 1) * gap
    }}

    function tileH(rows) {{
        return rows * unit + (rows - 1) * gap
    }}

    function alpha(c, a) {{
        return Qt.rgba(c.r, c.g, c.b, a)
    }}
}}
"""


def preview(label, hex_color):
    try:
        r = int(hex_color[1:3], 16)
        g = int(hex_color[3:5], 16)
        b = int(hex_color[5:7], 16)
        print(f"  \033[48;2;{r};{g};{b}m  \033[0m {label:<32} {hex_color}")
    except Exception:
        print(f"  {label:<32} {hex_color}")


def _mako_alpha(hex6, aa):
    """#rrggbb + alpha-hex → #rrggbbaa (защита от мусора)."""
    h = (hex6 or "").strip()
    if not re.match(r"^#[0-9a-fA-F]{6}$", h):
        h = "#00aba9"
    return h + aa


def _mako_user_values():
    """timeout/anchor/max-visible юзера из текущего mako-конфига (пережить реген темы)."""
    timeout, anchor, maxvis = 6000, "top-right", 3
    try:
        if os.path.isfile(MAKO_CONF):
            txt = open(MAKO_CONF, encoding="utf-8").read()
            m = re.search(r"^default-timeout\s*=\s*(\d+)", txt, re.MULTILINE)
            if m:
                timeout = int(m.group(1))
            m = re.search(r"^anchor\s*=\s*(.+)$", txt, re.MULTILINE)
            if m and m.group(1).strip():
                anchor = m.group(1).strip()
            m = re.search(r"^max-visible\s*=\s*(\d+)", txt, re.MULTILINE)
            if m:
                maxvis = int(m.group(1))
    except Exception:
        pass
    return timeout, anchor, maxvis


def build_mako_config(tokens, theme_name, vivid_accent):
    timeout, anchor, maxvis = _mako_user_values()
    if theme_name == "material":
        primary = tokens.get("primary", DEFAULT_TOKENS["primary"])
        surface_container = tokens.get("surface_container", DEFAULT_TOKENS["surface_container"])
        surface_low = tokens.get("surface_container_low", DEFAULT_TOKENS["surface_container_low"])
        on_surface = tokens.get("on_surface", DEFAULT_TOKENS["on_surface"])
        on_variant = tokens.get("on_surface_variant", DEFAULT_TOKENS["on_surface_variant"])
        outline_var = tokens.get("outline_variant", DEFAULT_TOKENS["outline_variant"])
        error = tokens.get("error", DEFAULT_TOKENS["error"])
        error_container = tokens.get("error_container", DEFAULT_TOKENS["error_container"])
        on_error_container = tokens.get("on_error_container", DEFAULT_TOKENS["on_error_container"])
        return f"""# Metro Shell — Material You notifications (Pixel UI, M3 dynamic color)
# Generated by metro-colors from the wallpaper: bg/border/progress follow primary.
font=Google Sans 11
background-color={_mako_alpha(surface_container, "e6")}
text-color={_mako_alpha(on_surface, "ff")}
width=400
height=150
margin=20
padding=14,18
border-size=1
border-color={_mako_alpha(primary, "88")}
border-radius=18
progress-color={_mako_alpha(primary, "ff")}
icons=1
max-icon-size=48
actions=1
markup=1
format=<b>%s</b>\\n%b
default-timeout={timeout}
ignore-timeout=0
layer=overlay
anchor={anchor}
max-visible={maxvis}
sort=-time

[urgency=low]
border-color={_mako_alpha(outline_var, "66")}
background-color={_mako_alpha(surface_low, "e6")}
text-color={_mako_alpha(on_variant, "ff")}
default-timeout=4000

[urgency=normal]
border-color={_mako_alpha(primary, "88")}
background-color={_mako_alpha(surface_container, "e6")}

[urgency=critical]
border-color={_mako_alpha(error, "ff")}
background-color={_mako_alpha(error_container, "e6")}
text-color={_mako_alpha(on_error_container, "ff")}
default-timeout=0
"""
    acc = vivid_accent or tokens.get("primary", "#00aba9")
    if not re.match(r"^#[0-9a-fA-F]{6}$", acc):
        acc = "#00aba9"
    if theme_name == "wp":
        return f"""# Metro Shell — Windows Phone notifications (True Metro, sharp corners)
# Generated by metro-colors: border/progress follow wallpaper/pin ({acc}).
font=Segoe UI Variable Static Text 11
background-color=#000000e6
text-color=#ffffffff
width=380
height=140
margin=20
padding=12,16
border-size=2
border-color={_mako_alpha(acc, "ff")}
border-radius=0
progress-color={_mako_alpha(acc, "ff")}
icons=1
max-icon-size=48
actions=1
markup=1
format=<b>%s</b>\\n%b
default-timeout={timeout}
ignore-timeout=0
layer=overlay
anchor={anchor}
max-visible={maxvis}
sort=-time

[urgency=low]
border-color=#ffffff66
default-timeout=4000

[urgency=critical]
border-color=#e51400ff
background-color=#000000e6
default-timeout=0
text-color=#ffffffff
"""
    return f"""# Metro Shell — Metro Live Tiles notifications (acrylic + vivid accent)
# Generated by metro-colors: border/progress follow wallpaper/pin ({acc}).
font=Segoe UI Variable Static Text 11
background-color=#12121ae6
text-color=#f7f7f7ff
width=380
height=140
margin=20
padding=12,16
border-size=1
border-color={_mako_alpha(acc, "55")}
border-radius=12
progress-color={_mako_alpha(acc, "ff")}
icons=1
max-icon-size=48
