#!/bin/bash
# metro-lock — lock screen on quickshell (replaces hyprlock)
#   metro-lock            real session lock (WlSessionLock, ext-session-lock-v1)
#   metro-lock --debug    overlay WITHOUT session lock (for testing)
# Background: always the current wallpaper ($HOME/.local/state/metro/wall),
# copied to $XDG_RUNTIME_DIR. No screen snapshots (privacy + no TOCTOU).

DEBUG=0
case "${1:-}" in
  "") ;;
  --debug) DEBUG=1 ;;
  -h|--help) echo "Usage: metro-lock [--debug]"; exit 0 ;;
  *) echo "metro-lock: unknown argument '$1' (only --debug allowed)" >&2; exit 2 ;;
esac

# Wallpaper -> runtime copy (0600, per-user dir, no fixed /tmp path)
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
BG="$RUNTIME/qs-lock-bg.png"
WALL=$(cat "$HOME/.local/state/metro/wall" 2>/dev/null)
if [ -n "$WALL" ] && [ -f "$WALL" ]; then
    cp -f "$WALL" "$BG" 2>/dev/null && chmod 600 "$BG" 2>/dev/null
    export METRO_LOCK_BG="$BG"
else
    rm -f "$BG" 2>/dev/null
    echo "metro-lock: no wallpaper found — using dark fallback" >&2
fi

# [c] in pattern prevents pgrep/pkill from matching itself
PAT="quickshell -p .*metro-lo[c]k$"
RUNNING=$(pgrep -f "$PAT" | head -n1)
MARK="$RUNTIME/qs-metro-lock.debug"
if [ -n "$RUNNING" ]; then
    if [ -f "$MARK" ]; then
        pkill -f "$PAT"; sleep 0.2     # replace running debug instance
    elif [ "$DEBUG" = 1 ]; then
        echo "metro-lock: real lock is active — refusing debug overlay" >&2
        exit 1                         # never kill a real lock
    else
        exit 0                         # real lock already active
    fi
fi
rm -f "$MARK"
[ "$DEBUG" = 1 ] && touch "$MARK" && chmod 600 "$MARK"

LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/metro/logs"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/qs-metro-lock.log"
if [ "$DEBUG" = 1 ]; then
    METRO_LOCK_DEBUG=1 QT_QPA_PLATFORMTHEME=gtk3 \
        setsid quickshell -p "$HOME/.config/quickshell/metro-lock" >"$LOG" 2>&1 </dev/null &
    echo "metro-lock DEBUG started (session NOT locked), log: $LOG"
else
    QT_QPA_PLATFORMTHEME=gtk3 \
        setsid quickshell -p "$HOME/.config/quickshell/metro-lock" >"$LOG" 2>&1 </dev/null &
    echo "screen locked, log: $LOG"
fi
