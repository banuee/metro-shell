# Metro Shell — Material You notifications (Pixel UI, M3 dynamic color)
# Generated by metro-colors from the wallpaper: bg/border/progress follow primary.
font=Google Sans 11
background-color=#1c211be6
text-color=#e0e4dbff
width=400
height=150
margin=20
padding=14,18
border-size=1
border-color=#9fd49c88
border-radius=18
progress-color=#9fd49cff
icons=1
max-icon-size=48
actions=1
markup=1
format=<b>%s</b>\n%b
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right
max-visible=3
sort=-time

[urgency=low]
border-color=#42494066
background-color=#181d17e6
text-color=#c2c9bdff
default-timeout=4000

[urgency=normal]
border-color=#9fd49c88
background-color=#1c211be6

[urgency=critical]
border-color=#ffb4abff
background-color=#93000ae6
text-color=#ffdad6ff
default-timeout=0
