# Metro Live Tiles — стиль уведомлений (стекло + акцент teal)
font=Segoe UI Variable Static Text 11
background-color=#12121ae8
text-color=#f7f7f7ff
width=380
height=140
margin=20
padding=12,16
border-size=1
border-color=#00aba955
border-radius=10
progress-color=#00aba9ff
icons=1
max-icon-size=48
actions=1
markup=1
format=<b>%s</b>\n%b
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right
max-visible=3
sort=-time

[urgency=low]
border-color=#ffffff30
default-timeout=4000

[urgency=critical]
border-color=#e5484dff
default-timeout=0
text-color=#ffffffff
